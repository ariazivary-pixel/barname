// برنامه‌ریزی ساعت‌ها
function plan(k,d){const day=dayOf(k),st=S.set;const work=day.work!=null?day.work:wdOf(d)!==6;const fixed=[],BL=day.blocks||(wdOf(d)==6?[]:st.blocks||[]),inB=t=>t.in&&BL.find(b=>String(b.id)==String(t.in));
