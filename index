$('nav').innerHTML=[['today','امروز'],['cal','تقویم'],['hab','عادت‌ها'],['fin','هزینه'],['stat','آمار'],['set','تنظیمات']].map(x=>'<button data-a="tab" data-t="'+x[0]+'" class="'+(tab==x[0]?'on':'')+'">'+x[1]+(x[0]=='hab'&&S.habits.length?' ('+fa(S.habits.length)+')':'')+'</button>').join('')}
document.addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(!b)return;const a=b.dataset.a,k=key(cur);if(b.tagName=='A')e.preventDefault();if(a=='lin'||a=='lup'){doAuth(a=='lup');return}if(a=='lskip'){hideLogin();return}if(a=='logout'){doLogout();return}if(a=='login'){showLogin();return}
if(a=='tab'){advMsg='';tab=b.dataset.t;if(tab=='cal')calM=jdate(cur).slice(0,2)}
else if(a=='day')cur.setDate(cur.getDate()+ +b.dataset.n);
else if(a=='now'){cur=new Date();cur.setHours(12)}
else if(a=='mon'){let[y,m]=calM;m+=+b.dataset.n;if(m>12){m=1;y++}if(m<1){m=12;y--}calM=[y,m]}
else if(a=='pick'){const p=b.dataset.k.split('-');cur=new Date(+p[0],+p[1]-1,+p[2],12);tab='today'}
else if(a=='add'){const t=$('tt').value.trim();if(!t){$('tt').focus();return}const d=S.days[k]=S.days[k]||{tasks:[]};d.tasks.push({id:Date.now(),t,top:$('tp').value,w:+$('tw').value,need:+$('tn').value,dur:+$('td').value||30,start:$('ts').value,in:$('tb').value,inT:$('tb').selectedOptions[0].textContent,done:false});autoPay(d.tasks[d.tasks.length-1],k);trackRec(d.tasks[d.tasks.length-1],k)}
else if(a=='chk'){const t=dayOf(k).tasks.find(x=>x.id==b.dataset.id);t.done=b.checked}
else if(a=='del'){S.days[k].tasks=S.days[k].tasks.filter(x=>x.id!=b.dataset.id);fin().exp=fin().exp.filter(e=>!(e.tid==b.dataset.id&&!e.a))}
else if(a=='tech'){open[b.dataset.id]=!open[b.dataset.id]}
else if(a=='fix'){const t=S.days[k].tasks.find(x=>x.id==b.dataset.id);t.start=ts(+b.dataset.s).replace(/[۰-۹]/g,c=>FA.indexOf(c));trackRec(t,k)}
else if(a=='work'){const d=S.days[k]=S.days[k]||{tasks:[]};d.work=b.checked}
else if(a=='hadd'){const n=$('hn').value.trim();if(!n){$('hn').focus();return}if(S.habits.length>=10)return;const g=+$('hg').value||10;S.habits.push({loc:$('hl').value.trim(),fs:$('hs').value.trim(),id:Date.now(),name:n,cue:$('hc').value.trim()||'بیدار شدن',rw:$('hr').value.trim(),time:$('ht').value,goal:g,min:Math.min(2,g),log:{},tech:+$('hq').value,trap:-1,pts:+$('hv').value,cr:key(new Date())})}
else if(a=='hchk'){const h=S.habits.find(x=>x.id==b.dataset.id);h.log[k]=b.checked?h.min:false;fundTog(h,k,b.checked);if(b.checked){const s=streak(h);if(k==key(new Date())&&s%7==0&&h.min<h.goal)h.min=Math.min(h.goal,Math.ceil(h.min*1.5))}}
else if(a=='hdel'){if(hdp==b.dataset.id){S.habits=S.habits.filter(x=>x.id!=b.dataset.id);hdp=0}else hdp=b.dataset.id}
else if(a=='dn'){S.days[k].tasks.find(x=>x.id==b.dataset.id).done=true}
else if(a=='breset'){if(S.days[k])delete S.days[k].blocks}
else if(a=='badd'||a=='bdel'){const L=b.dataset.sc=='day'?dblk(k):S.set.blocks;if(a=='badd')L.push({id:Date.now(),t:'فعالیت جدید',s:'12:00',e:'13:00'});else{const i=L.findIndex(x=>x.id==b.dataset.id);if(i>=0)L.splice(i,1)}}
else if(a=='qa'){const h=S.habits.find(x=>x.id==b.dataset.id),g=n=>+$(n+'_'+h.id).value;h.qa={a:[g('q1'),g('q2'),g('q3'),g('q4'),g('q5'),g('cp'),g('q6')],dt:key(new Date())};h.trap=schema(h,hdata(h))[0].i}
else if(a=='hlite'){const h=S.habits.find(x=>x.id==b.dataset.id);h.min=Math.max(1,Math.ceil(h.min/2))}
else if(a=='thsave'){const sv=$('th1').value.trim(),th=$('th2').value.trim(),re=$('th3').value.trim(),md=+$('th4').value;if(!th){$('th2').focus();return}
if(/خودکشی|آسیب به خود|خودم را بکش|بمیرم|نمی.?خواهم زنده/.test(sv+' '+th+' '+re))advMsg='SAFE';else{const si=kwS(th);advMsg=advise(md,si);(S.thoughts=S.thoughts||[]).unshift({id:Date.now(),d:key(new Date()),s:sv,t:th,r:re,m:md,sc:si});S.thoughts=S.thoughts.slice(0,30)}}
else if(a=='qre'){delete S.habits.find(x=>x.id==b.dataset.id).qa}
else if(a=='happ'){S.habits.find(x=>x.id==b.dataset.id).tech=+b.dataset.t}
else if(a=='fmon'){let[y,m]=fm;m+=+b.dataset.n;if(m>12){m=1;y++}if(m<1){m=12;y--}fm=[y,m]}
else if(a=='finadd'){const x=pn($('ia').value);if(!x){$('ia').focus();return}fin().inc.push({id:Date.now(),a:x,d:rD('id'),n:$('inn').value.trim()})}
else if(a=='fexadd'){const x=pn($('ea').value);if(!x){$('ea').focus();return}fin().exp.push({id:Date.now(),a:x,c:+$('ec').value,d:rD('ed'),n:$('enn').value.trim()})}
else if(a=='fpay'){const e=fin().exp.find(x=>x.id==b.dataset.id),x=pn($('pa_'+b.dataset.id).value);if(!x){$('pa_'+b.dataset.id).focus();return}e.a=x}
else if(a=='fdel'){fin()[b.dataset.k]=fin()[b.dataset.k].filter(x=>x.id!=b.dataset.id)}
else if(a=='rec2h'){const r=Object.values(S.rec||{}).find(x=>x.id==b.dataset.id);if(r&&S.habits.length<10){const g=Math.max(2,Math.min(r.dur||10,60));S.habits.push({id:Date.now(),name:r.t,cue:'رسیدن ساعت '+r.st,rw:'',time:r.st,goal:g,min:Math.min(2,g),log:{},tech:0,trap:-1,pts:0,cr:key(new Date()),loc:'',fs:''});r.conv=1}}
else if(a=='exp'){bk=JSON.stringify(S)}
else if(a=='imp'){try{const o=JSON.parse($('bk').value);if(o&&o.days){S=o;S.habits=S.habits||[];S.set=Object.assign({wake:'07:00',ws:'08:00',we:'17:00',sleep:'23:00'},S.set);bk=''}}catch(x){alert('متن پشتیبان معتبر نیست')}}
save();render()});
document.addEventListener('change',e=>{const t=e.target,n=t.dataset.set;if(t.id=='hq'){$('hqd').textContent=TECH[t.value][1];return}if(t.dataset.fx){const e=fin().exp.find(x=>x.id==t.dataset.fx);if(e){e.c=+t.value;save()}return}if(n){S.set[n]=t.value;save();render();return}if(t.dataset.hf){const h=S.habits.find(x=>x.id==t.dataset.id);if(h){h[t.dataset.hf]=+t.value;save();render()}return}if(t.dataset.bf){const L=t.dataset.sc=='day'?dblk(key(cur)):S.set.blocks,x=L.find(y=>y.id==t.dataset.id);if(x){x[t.dataset.bf]=t.value;save();render()}}});
