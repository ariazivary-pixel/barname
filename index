if(t!='hab')r+='<div>💸 هزینهٔ هفته: <b>'+money(te)+'</b> تومان'+(t=='fin'?' · 📥 ورودی هفته: '+money(ti)+' تومان':'')+'</div>';
return'<details class="card"'+(fri?' open':'')+'><summary><b>📊 خلاصهٔ این هفته'+(fri?' — مرور آخر هفته 🎉':'')+'</b></summary>'+r+'</details>'}
function mealCard(){const s=S.set,f=(l,n)=>'<div><label>'+l+'</label><input type="time" data-set="'+n+'" value="'+(s[n]||'')+'"></div>';
return'<div class="card"><h2>🍽️ ناهار و شام</h2><div class="grid2">'+f('شروع ناهار','ls')+f('پایان ناهار','le')+f('شروع شام','ds')+f('پایان شام','de')+'</div><div class="note">این بازه‌ها از زمان آزاد کم می‌شوند و در ساعت‌های امروز دیده می‌شوند. برای حذف، ساعت‌ها را پاک کن.</div></div>'}
let hdp=0;const RX=/خواب|ناهار|شام|شغل|محل کار|کار ثابت/;
function trackRec(t,k){if(!t.start||t.in||t.top==TOP[5]||RX.test(t.t))return;const R=S.rec=S.rec||{},kk=t.t.trim()+'@'+t.start,r=R[kk]=R[kk]||{id:Date.now(),t:t.t.trim(),st:t.start,dur:t.dur||30,days:[]};if(!r.days.includes(k))r.days.push(k);r.days=r.days.slice(-30)}
function stopped(h,d){const T=new Date(),k=n=>key(new Date(T.getTime()-n*864e5));return!h.log[k(0)]&&!h.log[k(1)]&&!h.log[k(2)]&&((h.cr&&h.cr<=k(2))||d.td>0)}
function cheer(h,d){const T=new Date(),k=n=>key(new Date(T.getTime()-n*864e5)),done=!!h.log[k(0)],y=!!h.log[k(1)];let m;
if(done)m='✅ امروز انجامش دادی'+(d.td>1?' (تا حالا '+fa(d.td)+' روز)':'')+'؛ همین یعنی ادامه دادن. کوچک بودنش اهمیتی ندارد.';
else if(d.td==0)m='🌱 شروع می‌تواند خیلی کوچک باشد؛ فقط '+fa(h.min)+' دقیقه. بعدش هر وقت خواستی تمامش کن.';
else if(!y&&!h.log[k(2)])m='💛 چند روز جا افتاد و این به معنی شکست نیست. امروز فقط نسخهٔ خیلی کوچکش را انجام بده.';
else if(!y)m='🙂 دیروز جا افتاد؛ قانون ساده: دو بار پشت سر هم جا نینداز.';
else m='👍 دیروز انجام دادی؛ امروز هم با یک قدم کوچک ادامه بده.';
return'<div class="note" style="margin-top:6px">'+m+'</div>'}
function habBanner(){const n=S.habits.length,full=n>=10,bd=S.habits.find(h=>{const d=hdata(h);return d.td>0&&d.td<6&&!stopped(h,d)});
let o='<div class="card"><b>📌 '+fa(n)+' از ۱۰ عادت</b>'+(full?'<div class="sug">به سقف ۱۰ عادت رسیده‌ای؛ برای عادت جدید، یکی از قبلی‌ها را حذف کن.</div>':bd?'<div class="note">🌤️ عادت «'+esc(bd.name)+'» هنوز در حال ساخته شدن است؛ اضافه‌کردن همزمان چند عادت جدید توصیه نمی‌شود، ولی ممنوع هم نیست.</div>':'')+'</div>';
const C=Object.values(S.rec||{}).filter(r=>!r.conv&&r.days.length>=3&&!S.habits.some(h=>h.name==r.t));
if(C.length&&!full)o+='<div class="card"><h2>🔁 کارهای تکراری با ساعت مشخص</h2><div class="note">این کارها چند روز در یک ساعت ثبت شده‌اند؛ می‌توانی عادتشان کنی.</div>'+C.map(r=>'<div class="item"><div class="gr"><b>'+esc(r.t)+'</b><div class="note">ساعت '+ts(tm(r.st))+' · '+fa(r.days.length)+' روز ثبت شده</div></div><button class="p f0" data-a="rec2h" data-id="'+r.id+'">تبدیل به عادت</button></div>').join('')+'</div>';
return o}
function vHabW(){return habBanner()+vHab2()}
